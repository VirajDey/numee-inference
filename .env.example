# Shared secret the calling service sends as X-Internal-Token.
# Generate with: openssl rand -hex 32
INFERENCE_SERVICE_TOKEN=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
OPENAI_VECTOR_SIZE=1536
SENTENCE_TRANSFORMER_VECTOR_SIZE=384

# Embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=

# Concurrent embedding / parsing operations. Size to the CPU allocation.
INFERENCE_MAX_CONCURRENCY=4

LOG_LEVEL=INFO
